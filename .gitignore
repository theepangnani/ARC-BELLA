# secrets — never commit these
.env
.env.*
!.env.example
credentials.json
token.json

# telegram session = full account access
*.session
*.session-journal

# audit logs
sent-by-arc*.log
ran-by-arc.log

# personal data
todos.json
reminders.json

# Bella's dedicated browser-window profile
.arc-window/

__pycache__/
*.pyc

# tunnel binary (large; download per-machine)
cloudflared.exe

# generated per-tunnel QR (URL changes every start)
phone-qr.png

# per-user Google web OAuth client (contains secret)
credentials_web.json

# per-user Google tokens (one file per browser session)
google_sessions/

# live login sessions — deleting this file signs everyone out
sessions.json

# quick notes (personal)
notes.json

# Market price alerts (personal watchlist)
price_alerts.json

# Alarms (personal — when you get up)
alarms.json
alarms.json.tmp

# Security assessment: documents live, unfixed findings for an
# internet-exposed instance. Kept local until the credentials it names are
# rotated; publishing it to a public repo would be an attack map.
docs/SECURITY.md
