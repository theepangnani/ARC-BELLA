# secrets — never commit these
.env
.env.*
!.env.example
credentials.json
token.json

# telegram session = full account access
*.session
*.session-journal

# audit logs
sent-by-arc*.log
ran-by-arc.log

# personal data
todos.json
reminders.json

# Bella's dedicated browser-window profile
.arc-window/

__pycache__/
*.pyc

# tunnel binary (large; download per-machine)
cloudflared.exe

# generated per-tunnel QR (URL changes every start)
phone-qr.png

# per-user Google web OAuth client (contains secret)
credentials_web.json

# per-user Google tokens (one file per browser session)
google_sessions/

# live login sessions — deleting this file signs everyone out
sessions.json

# quick notes (personal)
notes.json

# Market price alerts (personal watchlist)
price_alerts.json

# Standing rules, the usage record, and what ARC knows about you
triggers.json
usage.json
memory.json

# Exports — your whole data folder in one file, for copying elsewhere
arc-export-*.json

# Alarms (personal — when you get up)
alarms.json

# Half-written files, mid-save. Every data write goes to one of these and
# is then moved into place, so one on disk means a save was interrupted.
*.json.tmp

# Security assessment: documents live, unfixed findings for an
# internet-exposed instance. Kept local until the credentials it names are
# rotated; publishing it to a public repo would be an attack map.
docs/SECURITY.md

# Backups of your own data, taken before any self-repair touches it
backups/

# What self-repair did, and when
repairs.log

# Cached voice catalogue (refetched weekly)
voices.json

# Transient probe from the self-check ("can I still write here?")
.write-probe

# The guardian's own output. Runtime, per machine, and the log is a record of
# what went wrong HERE — it is for the person coming home, not for the repo.
guardian.log
guardian-status.json
guardian-status.json.tmp
