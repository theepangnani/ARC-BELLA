# Required — from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — a real voice instead of the browser synthesiser.
# Key: https://elevenlabs.io/app/settings/api-keys
# Voice ID: open any voice in the Voice Library, copy the ID from the URL.
# Look for a deep British male voice; "George" and "Daniel" are good starts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides
# ARC_MODEL=claude-haiku-4-5     # faster and cheaper for a voice loop
# ARC_PORT=8420
