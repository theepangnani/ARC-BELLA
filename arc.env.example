# Template for the PRIVATE Bella's settings.
#
# Copy this to  ../bella-private/arc.env  and fill it in. That folder lives
# beside the repo, never inside it — it holds your passphrase and a signed-in
# browser profile, so it must never be committed or pushed anywhere.
#
#   cp arc.env.example ../bella-private/arc.env
#
# Everything here is optional. launch-bella-private.ps1 prompts for a
# passphrase if you leave ARC_PASSWORD unset, and sensible defaults apply to
# the rest. ARC_PORT, ARC_DATA_DIR and ARC_APP_VARIANT are set by the launcher
# itself — don't put them here.
#
# Your Anthropic and ElevenLabs keys are NOT set here. They come from the
# repo's own .env, which the private instance shares.

# Passphrase for the private instance. Leave blank to be asked at each launch,
# which is the safer choice — set it only if you want one-click startup.
ARC_PASSWORD=

# Which Claude model answers. Unset is the balanced default; haiku is faster
# and cheaper for a voice loop, opus is the most capable.
ARC_MODEL=
ARC_EFFORT=

# Spend tracking. The price fields are only used to turn tokens into a number
# on screen — they don't bill anything, so update them if pricing changes.
ARC_PRICE_IN_PER_MTOK=
ARC_PRICE_OUT_PER_MTOK=

# Stops a runaway loop costing real money. Recommended.
ARC_DAILY_COST_CAP=

# Phone push notifications, if you use them.
ARC_NTFY_TOPIC=
