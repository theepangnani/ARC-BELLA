# Template for the PRIVATE Bella's settings.
#
# Copy this to  ../bella-private/arc.env  and fill it in. That folder lives
# beside the repo, never inside it — it holds a signed-in browser profile and
# this instance's own Google session, so it must never be committed anywhere.
#
#   cp arc.env.example ../bella-private/arc.env
#
# Everything here is optional; sensible defaults apply. ARC_PORT, ARC_DATA_DIR
# and ARC_APP_VARIANT are set by the launcher itself — don't put them here.
#
# Your Anthropic and ElevenLabs keys are NOT set here. They come from the
# repo's own .env, which the private instance shares.

# Who may sign in to the PRIVATE instance. Defaults to the same allowlist as
# the shared one; set it here to differ.
#
# NOTE: the private instance runs on port 8421, so its redirect URI
# (http://localhost:8421/oauth/callback) must be added to the Google Cloud
# console alongside the 8420 one, or sign-in will be rejected by Google.
ARC_ALLOWED_EMAILS=

# Which Claude model answers. Unset is the balanced default; haiku is faster
# and cheaper for a voice loop, opus is the most capable.
ARC_MODEL=
ARC_EFFORT=

# Spend tracking. The price fields are only used to turn tokens into a number
# on screen — they don't bill anything, so update them if pricing changes.
ARC_PRICE_IN_PER_MTOK=
ARC_PRICE_OUT_PER_MTOK=

# Stops a runaway loop costing real money. Recommended.
ARC_DAILY_COST_CAP=

# Phone push notifications, if you use them.
ARC_NTFY_TOPIC=

# While an alarm is set, its poll counts as use so the tab is still signed
# in when the alarm goes off. 0 = strict idle timeout; alarms then still
# fire and still reach your phone, but won't ring in a tab left open.
ARC_ALARM_KEEPS_SESSION=1

